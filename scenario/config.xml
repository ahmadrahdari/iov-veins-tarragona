<?xml version="1.0" encoding="UTF-8"?>
<!-- Radio propagation for the Tarragona scenario: free-space path loss plus
     building shadowing derived from the OpenStreetMap footprints (Veins
     SimpleObstacleShadowing, 9 dB per wall and 0.4 dB per metre). -->
<root>
    <AnalogueModels>
        <AnalogueModel type="SimplePathlossModel" thresholding="true">
            <parameter name="alpha" type="double" value="2.0"/>
        </AnalogueModel>
        <AnalogueModel type="SimpleObstacleShadowing" thresholding="true">
            <obstacles>
                <type id="building" db-per-cut="9" db-per-meter="0.4" />
            </obstacles>
        </AnalogueModel>
    </AnalogueModels>
    <Decider type="Decider80211p">
        <parameter name="centerFrequency" type="double" value="5.890e9"/>
    </Decider>
</root>
