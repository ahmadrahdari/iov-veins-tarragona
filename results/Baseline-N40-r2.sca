attr replication #2
attr resultdir results
attr runnumber 5
attr seedset 2
itervar N 40
config image-path /home/claude/sim/src/veins/images:/home/claude/sim5g/simu5g/images
config *.car[*].app[0].useHandover false
config *.car[*].app[0].m1Bits 672
config *.car[*].app[0].cV1 0.3714ms
